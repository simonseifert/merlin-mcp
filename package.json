{
  "name": "merlin-mcp",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "build:node": "tsc -p tsconfig.node.json",
    "start": "node dist/node.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "description": "Read-only MCP server for Merlin (SRCE Moodle): grades, deadlines, files and messages for AI agents, with phone-approved sends",
  "overrides": {
    "undici": "^7.30.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/simonseifert/merlin-mcp.git"
  },
  "homepage": "https://github.com/simonseifert/merlin-mcp"
}
