# Copy to merlin.env (gitignored), fill in, then: docker run --env-file merlin.env ...
MOODLE_TOKEN=
# MOODLE_TOKENS={"2025-2026":"...","2026-2027":"..."}
MCP_BEARER=
API_BEARER=
# RELAY_BEARER=          # only if you run your own approval relay (polls /api/pending)
# Built-in phone approval (either or both). The URLs are secrets: anyone who reads them can approve.
# NOTIFY_NTFY_URL=https://ntfy.sh/<your-long-random-topic>
# NOTIFY_NTFY_TOKEN=     # optional bearer for a protected ntfy server
# NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...
# NOTIFY_WEBHOOK_FORMAT=discord   # or json (default)
# MOODLE_CONTACT=you@example.com
# MERLIN_PUBLIC_URL=https://merlin.example.com   # behind a reverse proxy, for approval links
# MERLIN_ENABLE_SEND=0   # leave the send tool out entirely
# HOST=0.0.0.0          # Node listens on 127.0.0.1 by default; the Docker image sets 0.0.0.0
# PORT=8787
